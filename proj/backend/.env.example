# Cistus Q&A 백엔드 환경변수 예시 (.env)
# 실서버에서는 이 파일을 `proj/backend/.env`로 복사하거나 systemd `EnvironmentFile=`에 지정하세요.

# === 1. SMTP 발송 설정 (예: Gmail + 앱 비밀번호) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-bot@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-bot@gmail.com

# === 2. IMAP 답장 자동 등록 (nip.io 환경 권장) ===
# IMAP_ENABLED=true만 켜도 위 SMTP_USER / SMTP_PASS와 Reply-To(<아이디>+<토큰>@gmail.com)를 자동 추론합니다.
IMAP_ENABLED=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_POLL_INTERVAL_SECONDS=20

# === 3. (선택) 커스텀 도메인 + Cloudflare Email Worker 사용 시 ===
# EMAIL_REPLY_DOMAIN=reply.your-domain.com
# EMAIL_REPLY_PREFIX=reply
# EMAIL_WEBHOOK_SECRET=replace-with-long-random-secret
