# Cistus Q&A 목업 백엔드 환경변수 예시 (.env)
# 기존 서버와 병행 배포 시 `proj_mockup/backend/.env`로 복사해 사용하세요.

# === 1. 서버 포트 (기존 proj와 8080 충돌 방지) ===
PORT=8081
ENABLE_DEMO_USERS=true

# === 2. 데이터베이스 설정 (선택) ===
# 미설정 시 인메모리 H2 DB를 사용합니다 (서버 재시작 시 초기화).
#
# [옵션 A] 파일 기반 H2 DB (외부 DB 없이 데이터 영구 저장)
# DB_DRIVER=org.h2.Driver
# DB_URL=jdbc:h2:file:./data/mockup_db;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
# DB_USER=sa
# DB_PASSWORD=
#
# [옵션 B] PostgreSQL 별도 DB 사용 (기존 proj DB와 분리)
# DB_DRIVER=org.postgresql.Driver
# DB_URL=jdbc:postgresql://localhost:5432/cistus_mockup
# DB_USER=cistus_mockup
# DB_PASSWORD=change-this-password

# === 3. 운영 보안/CORS 설정 (필요 시) ===
# AUTH_TOKEN_SECRET=replace-with-random-secret-at-least-32-chars
# CORS_ALLOWED_ORIGINS=https://mockup.your-domain.example
